# SQLite works out of the box; for PostgreSQL use e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
DATABASE_URL=sqlite:///./expenses.db
JWT_SECRET=change-this-to-a-long-random-secret

# Used by mcp_server.py to act on behalf of a registered user
EXPENSE_USER_EMAIL=you@example.com
EXPENSE_USER_PASSWORD=your_password
